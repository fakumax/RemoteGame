    "setup": "npm ci && npm ci --prefix netplay-node",
    "test:browser": "node scripts/smoke-browser.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
