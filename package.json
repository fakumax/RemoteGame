{
  "name": "remotegame",
  "version": "0.5.0",
  "description": "Biblioteca de emulación web con NES 2P sincronizado y EmulatorJS experimental",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --open",
    "local": "node server.js --no-share",
    "netplay": "node netplay-node/index.js",
